# Generated by the IntelliJ Platform Gradle Plugin
.intellijPlatform/

# Preview test harness. The lockfile is kept: `npm ci` in CI needs it, and the
# harness's result should not depend on when its dependencies were installed.
tools/preview-test/node_modules/
tools/preview-test/*.class

# Playwright's own output. The baselines under visual/__screenshots__/ are the
# point of the suite and are committed; these are what a run produces about them.
tools/preview-test/test-results/
tools/preview-test/playwright-report/
tools/preview-test/blob-report/
